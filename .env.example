# Copy to .env and adjust. Every variable is optional; defaults are shown.
# All of these are read in app/config.py (ANTHROPIC_API_KEY in app/services/score_markets.py).

# --- application -------------------------------------------------------------
APP_NAME=Polymarket News Terminal
# SQLite file; the directory is created on first start.
DATABASE_PATH=data/app.db

# --- Polymarket (Gamma API) --------------------------------------------------
POLYMARKET_BASE_URL=https://gamma-api.polymarket.com
# Default price window (decimal probability). Currently informational only:
# the /api/markets and /api/event-groups endpoints take their own query params.
PRICE_MIN=0.001
PRICE_MAX=0.20

# --- background scheduler ------------------------------------------------------
# Set to 0 to disable the 15-minute refresh loop (useful for tests / dev).
SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL_SEC=900
SCHEDULER_FIRST_DELAY_SEC=8

# --- optional LLM hook ----------------------------------------------------------
# When set, the top candidates get a fair-probability / importance estimate from
# the Anthropic Messages API and it is shown as an extra alert. Leave empty to run
# rules-only.
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-haiku-5-5

# --- reserved -------------------------------------------------------------------
# Placeholder for a paid news provider. Not used by the GDELT + RSS feed.
NEWS_API_KEY=
